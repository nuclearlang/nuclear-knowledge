// The local developer over HTTP (127.0.0.1:7879): POST /developer/code, /test, /security, /document, /chat, /diagnose and /plan. Each request
// runs on a thread of its own, so nothing of one request reaches the next.
@controller("developer")
controller DeveloperController(coder: Coder, tester: Tester, security: Security, documenter: Documenter, assistant: Assistant, diagnoser: Diagnoser, planner: Planner)
  @post("code", status = 200)
  code(input: PieceRequest) PieceReply
    reply(~coder.run(start(input), thread = fresh()))

  @post("test", status = 200)
  test(input: PieceRequest) PieceReply
    reply(~tester.run(start(input), thread = fresh()))

  @post("security", status = 200)
  review(input: PieceRequest) PieceReply
    reply(~security.run(start(input), thread = fresh()))

  @post("document", status = 200)
  document(input: PieceRequest) PieceReply
    reply(~documenter.run(start(input), thread = fresh()))

  @post("chat", status = 200)
  chat(input: ChatRequest) PieceReply
    state = { "task": input.message, "platform": input.platform, "map": input.map, "history": input.history }
    reply(~assistant.run(state, thread = fresh()))

  // Why a step failed: `task` is the step, `context` its output, `path` the project's folder.
  @post("diagnose", status = 200)
  diagnose(input: PieceRequest) PieceReply
    reply(~diagnoser.run(start(input), thread = fresh()))

  @post("plan", status = 200)
  plan(input: PlanRequest) PlanReply
    state = ~planner.run({ "task": input.spec, "platform": input.platform }, thread = fresh())
    PlanReply(pieces = state["pieces"]!, raw = state["report"]!, trace = state["trace"]!)

  fresh() string
    "${uuid4()}"

  start(input: PieceRequest) <string, any>
    { "task": input.task, "platform": input.platform, "path": input.path, "kind": input.kind, "context": input.context }

  reply(state: <string, any>) PieceReply
    PieceReply(code = state["code"]!, report = state["report"]!, check = state["check"]!, attempts = state["attempts"]!, trace = state["trace"]!)
