// The coder: writes one .nuc file from a precise task, with the graph's guide, knowledge and examples, and repairs it
// until `nuclear check` reports no errors. Prompts: agents/piece.md, agents/repair.md.
@state(PieceState)
graph Coder(bench: Workbench)
  @start
  @next("write")
  recall(state: PieceState) <string, any>
    found = ~bench.recall("${state.kind} ${state.task}", state.platform, "piece")
    detail = if found.note.length > 0
      found.note
    else
      "${found.knowledge.length} characters of knowledge, ${found.examples.length} of examples"
    { "guide": found.guide, "knowledge": found.knowledge, "examples": found.examples, "trace": state.trace + [bench.step("recall", detail)] }

  @next("end")
  write(state: PieceState) <string, any>
    done = ~bench.write(state, ~bench.compose(state), 3)
    { "code": done.code, "report": "", "check": done.check, "attempts": done.attempts, "trace": done.trace }
