// The state of one piece of work of a local agent: the task, what the graph gave it, its answer and its check.
PieceState
  task: string
  platform: string
  path: string
  kind: string
  context: string
  // the chat: the project's map and the last messages of the session
  map: string
  history: string
  // the diagnoser: the kind of a failure (transient, environment, code, test, spec, unknown)
  failure: string
  guide: string
  knowledge: string
  examples: string
  code: string
  report: string
  check: string
  attempts: int
  pieces: <string, string>[]
  trace: <string, string>[]
