// The tester: writes the Nuclear tests (`tests` kind) of a piece of code, checked like any other file. Prompts:
// agents/test.md (over the `test` guide), agents/piece.md, agents/repair.md.
@state(PieceState)
graph Tester(bench: Workbench)
  @start
  @next("write")
  recall(state: PieceState) <string, any>
    found = ~bench.recall("tests @test expect ${state.task}", state.platform, "test")
    guide = ~bench.prompt("test", { "guide": found.guide })
    { "guide": guide, "knowledge": found.knowledge, "examples": found.examples, "kind": "tests", "trace": state.trace + [bench.step("recall", "test guide and examples")] }

  @next("end")
  write(state: PieceState) <string, any>
    done = ~bench.write(state, ~bench.compose(state), 3)
    { "code": done.code, "report": "", "check": done.check, "attempts": done.attempts, "trace": done.trace }
