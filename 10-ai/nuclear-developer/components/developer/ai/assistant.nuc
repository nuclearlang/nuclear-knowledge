// The assistant: answers a message of the chat about the project, with the graph's knowledge, the project's map and
// the last messages of the session. It explains and proposes Nuclear; it changes no file (an order to change the
// project is a Loop run). Prompt: agents/chat.md.
@state(PieceState)
graph Assistant(bench: Workbench)
  @start
  @next("answer")
  recall(state: PieceState) <string, any>
    found = ~bench.recall(state.task, state.platform, "chat")
    { "guide": found.guide, "knowledge": found.knowledge, "examples": found.examples, "trace": state.trace + [bench.step("recall", "${found.knowledge.length} characters of knowledge")] }

  @next("end")
  answer(state: PieceState) <string, any>
    prompt = ~bench.prompt("chat", { "guide": state.guide, "knowledge": state.knowledge, "examples": state.examples, "map": state.map, "history": state.history, "message": state.task, "platform": state.platform })
    report = ~bench.ask("default", prompt)
    // `context`: the characters the model read, so the editor shows how full its context window was
    { "code": "", "report": report.trim(), "check": "ok", "attempts": 1, "trace": state.trace + [bench.step("context", "${prompt.length}"), bench.step("answer", bench.firstLine(report))] }
