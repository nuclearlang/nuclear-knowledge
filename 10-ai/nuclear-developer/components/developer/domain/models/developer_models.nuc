// One piece of work for a local agent: ONE file, named as precisely as possible.
PieceRequest
  @minLength(3)
  task: string
  // backend, mobile or web: the agents write Nuclear for a platform, never for a dialect
  platform: string = "backend"
  path: string = ""
  kind: string = ""
  context: string = ""

// What an agent answers: the code (or the review), its check and what it did, step by step.
PieceReply
  code: string
  report: string
  check: string
  attempts: int
  trace: <string, string>[]

// A spec to split into pieces.
PlanRequest
  @minLength(3)
  spec: string
  // backend, mobile or web: the agents write Nuclear for a platform, never for a dialect
  platform: string = "backend"

// The pieces of a plan, in the order they can be written.
PlanReply
  pieces: <string, string>[]
  raw: string
  trace: <string, string>[]

// What the Nuclear Smart Graph gave an agent for a task.
Recall
  guide: string
  knowledge: string
  examples: string
  note: string

// A message to the local assistant, with what it needs to answer about the project.
ChatRequest
  @minLength(1)
  message: string
  // backend, mobile or web
  platform: string = "backend"
  // the project's map (.nuclear/map.md): every declaration with its kind, description and members
  map: string = ""
  // the last messages of the session, oldest first, as `you: ...` / `agent: ...` lines
  history: string = ""
